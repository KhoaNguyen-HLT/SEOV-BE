        A.to_team,
        A.from_team_name,
        A.to_team_name,
        A.status,
        A.start_time,
        A.end_time,
        A.created_at,
        A.updated_at,
        A.is_active         
    from
        (             select
            A.*,
            B.name as user_name,
            C.group_name as from_team_name,
            D.group_name as to_team_name             
        from
            andon_process_log A             
        left join
            users B 
                on A.from_user = B.username             
        left join
            andon_group C 
                on A.from_team = C.group_code             
        left join
            andon_group D 
                on A.to_team = D.group_code             
        where
            A.request_id in (                 select
                a.id                  
            from
                andondata a                  
            where
                a.status != 'OK'                    
                and a.site_code = ?             )         ) A 
