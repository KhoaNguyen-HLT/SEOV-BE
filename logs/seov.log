2026-05-16T10:49:24.454+07:00 DEBUG 15196 --- [seov] [http-nio-0.0.0.0-8080-exec-1] org.hibernate.SQL                        : 
    SELECT
        a.id as id,
        a.site_code as siteCode,
        a.line_name as lineName,
        b.active as active,
        b.group_code as groupCode,
        b.group_name as groupName,
        a.description as description,
        a.error_stage as errorStage,
        a.team as team,
        a.flag as flag,
        a.status as status,
        a.processing_at as processingAt,
        a.completed_at as completedAt,
        a.created_at as createdAt,
        a.updated_at as updatedAt             
    FROM
        andondata a             
    LEFT JOIN
        andon_group b                  
            ON a.team = b.group_code             
    WHERE
        a.status != 'OK'               
        AND a.site_code =? 
    order by
        a.id; 
